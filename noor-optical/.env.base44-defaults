# Local development values for the NOOR OPTICAL compose stack.
#
# These are placeholders that let the app boot before real credentials exist.
# The platform delivers user-supplied secrets to /run/base44/app.env, which is
# listed AFTER this file in compose, so real values always win.

# Signing key for customer sessions. Replace with a long random value in production.
JWT_SECRET=development-only-change-me

# Staff account created by the seeder on first boot.
ADMIN_EMAIL=admin@nooroptical.example
ADMIN_PASSWORD=NoorAdmin!234

# Delivery options
DEFAULT_CURRENCY=IRT

# Extra browser origins allowed to call the API directly (comma separated).
CORS_ORIGINS=
